# These are read by Linux: a CRLF in a shell script breaks its shebang, and a
# CRLF in an env file becomes part of the value -- LAVA_RES_DIR would point at
# a path with a carriage return on the end. Git on Windows converts by default,
# so the files that leave this machine are pinned to LF here.
*.sh text eol=lf
deploy/env.example text eol=lf
deploy/Caddyfile.lava text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.py text eol=lf
# Read by rsync and by the suite runner in WSL: a CR would end every rule
# and every reason.
deploy/rsync.filter text eol=lf
tools/known_failures.txt text eol=lf
.github/** text eol=lf
# A systemd drop-in: a CR would end up in the path ExecStartPre= runs.
deploy/runner/scrub.conf text eol=lf
# Files players get byte for byte (client/files/README.md): the release lists
# their sha256, and an original's BOM and CRLF are part of it.
client/files/** -text
client/files/README.md text
# The owner's own location objects (client/objects/README.md): the release
# builds their sprite files from these bytes, so a picture is never touched.
client/objects/** -text
client/objects/manifest.json text eol=lf
client/objects/README.md text
# Read by Linux inside docker; run.sh names its image by these bytes.
tools/flash_headless/** text eol=lf
# The locations of ours (server/world.py OVERLAY): the server reads these
# bytes and the release ships them, and the static style ends in
# <serverdata>\r\n</serverdata> (tools/lavaloc.py write_static).
data/locations/static/** -text
