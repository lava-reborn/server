{
 "_": "Designed, not recovered: the client and the wiki hold no mob stat. One table by level; multiply hp/dmg/xp by the role and weapon multipliers of the type. Rationale and the player formulas this mirrors: docstring of data/build_mob_types.py (wiki 'Игромеханика', 'Таблица опыта', CC-BY-SA).",
 "formulas": {
  "ap": "50 + 5*L (wiki AP)",
  "armor": "5 + 1.5*L (attribute part + gear of the tier)",
  "dmg": "4 + 1.6*L .. 8 + 2.4*L, then * weapon dmg_mult * role dmg_mult",
  "dodge": "2*(5 + min(5, L//4)) + L + 3*min(5, L//4) (wiki dodge)",
  "hit": "49 + 1.25*L + 5*min(5, L//4), capped at 95 (wiki melee hit)",
  "hp": "player HP of the same level: 20 + 20*(5 + floor(0.75*(L-1)))",
  "sp": "same as hp (SP = 4*agility + 20*constitution)",
  "xp_pool": "4*hp: what a same-level player earns for the kill, wiki: floor((clamp(Lmob-Lplayer,-4,4)+4) * damage)"
 },
