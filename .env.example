# Copy to .env next to docker-compose.yml and fill in. Only the first line has
# to be set; everything else has a working default.

# The player's own res/ directory, mounted read-only into both containers.
# The server reads locations, database/mobs.xml and database/objects.xml out of
# it. A Windows path goes in as a Linux one under WSL:
#   /mnt/c/Users/<you>/Desktop/LAVA/res
LAVA_RES_DIR=/mnt/c/Users/gmkrt/OneDrive/Desktop/LAVA/res

# The address friends type into the client and into their lava.bat. The
# registration page prints it and the loaduser reply carries it, so a
# 127.0.0.1 here means nobody but this machine can play.
LAVA_PUBLIC_HOST=127.0.0.1

# Published ports. The game socket has to be reachable from outside; the
# registration page only has to be reachable by whoever registers.
LAVA_GAME_PORT=9775
LAVA_HTTP_PORT=8080

# Which interface docker publishes on. 0.0.0.0 is the whole machine; set
# 127.0.0.1 to keep both behind an ssh tunnel.
LAVA_BIND=0.0.0.0

# INFO, or DEBUG for the wire.
LAVA_LOG_LEVEL=INFO

# 1 serves the client's own files over HTTP, which also serves
# csettings_v1.xml and so takes the client off its own disk onto this server
# for every asset. Off is the point of running it this way.
LAVA_HTTP_RES=0

# Flash asks for the socket policy on 843 first and only falls back to the
# game port once that attempt ends. Where 843 is dropped rather than refused
# -- which is what a hosting provider's filter usually does -- the fallback
# costs a visible pause on every connect, so the listener is on by default.
# It binds this high port inside the container and docker publishes 843 to
# it, which keeps the privileged bind on dockerd's side. Set it to 0 to turn
# the second listener off; the inline answer on the game port still works.
LAVA_POLICY_PORT=8430
LAVA_POLICY_PUBLIC_PORT=843

# The admin panel at /admin. Empty means there is no panel: every /admin path
# answers 404. Generate one with `openssl rand -hex 24`; it is the whole of
# the authentication, and it travels in a cookie.
LAVA_ADMIN_TOKEN=

# Shown to a player the panel puts out of the game, in the client's own
# words: "Администратор <...> ведет работу над вашим аккаунтом".
LAVA_ADMIN_NAME=Администратор
