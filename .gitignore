logs/
# The scripts under tools/ are ours; the Flash projector and Ruffle that live
# beside them are downloaded binaries and stay out. Excluding the directory
# itself would make the negation below unreachable -- git does not re-include
# a file whose parent directory is excluded.
tools/*
!tools/*.py
!tools/run_suite.sh
!tools/run_suite.ps1
# Also ours: the list of failures CI is told to expect (tools/run_suite.sh --known).
!tools/known_failures.txt
# Also ours: the hook --record-map (tools/run_suite.sh, tools/suite.py) puts
# on the path of every process of the run.
!tools/impact/
# The quest editor page (tools/quest_editor.py): its source and the built
# page are ours; the packages npm fetches stay out (they live outside the
# checkout, see tools/quest_editor_ui/build.sh).
!tools/quest_editor_ui/
tools/quest_editor_ui/node_modules/
# Also ours: the headless Flash Player 32 check (tools/flash_headless/README.md).
# The projector it runs stays out; it is mounted, never copied in.
!tools/flash_headless/
dist/
.env
data/lava.db
data/lava.db-shm
data/lava.db-wal
data/lava.db.before-*
__pycache__/
*.pyc
.claude/
# The CI deploy key, should it be made here after all (README «CI/CD»: it
# belongs in ~/lava_ci). Also kept out of every deploy by deploy/rsync.filter.
/lava_ci
/lava_ci.pub
data/map_editor_base.png
# A developer's own release stand (client/devserve.py): its keys, store and
# test game folder. Never a key of production's.
/client/dev/
# The publisher's own record when it is run out of the repository by hand;
# on the server it lives in /opt/lava-ci/client/state.
/client/state/
