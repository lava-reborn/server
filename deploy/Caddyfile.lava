# The HTTPS front for the LAVA server, served by the Caddy that already holds
# 80 and 443 on this host for Agile Quest.
#
# It is appended to that project's Caddyfile (/opt/agile-quest/deploy/
# Caddyfile) and must be committed in THAT repository too: its own deploy.sh
# rsyncs the file, so a hand edit on the server lives exactly until its next
# deployment.
#
# reverse_proxy goes to the host's published port rather than to the
# container by name, which is the whole reason this needs no change to the
# Agile Quest stack: no shared docker network, no extra volume, no
# recreating its containers. 172.18.0.1 is the gateway of the network Caddy
# is on, which is this host; check it with
#
#     docker exec agile-caddy wget -qO- http://172.18.0.1:8080/status
#
# before trusting it, because a recreated network can renumber.
#
# Reload without restarting anything:
#
#     docker exec agile-caddy caddy reload --config /etc/caddy/Caddyfile
#
# DNS: lava.devmachine.tech has an A record on 159.194.247.90 (the apex
# points elsewhere and is none of our business). Let's Encrypt issues on
# that name by itself the first time it is asked for.

lava.devmachine.tech {
	encode zstd gzip

	# Only the registration page and the admin panel live here. The client
	# is not served -- players bring their own -- so there is nothing worth
	# caching, and an account count or an online list that lies is worse
	# than one fetched every time.
	header Cache-Control "no-store"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy 172.18.0.1:8080

	log {
		output file /data/lava-access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
