# Copied to /opt/lava/.env on the first deploy and then left alone.
# docker compose reads it from the directory it is started in.

# Where the client lives on the server. Pushed there by
# `bash deploy/deploy.sh --with-res`, mounted read-only into both services.
LAVA_RES_DIR=/opt/lava/res

# Hand the client out over HTTP. This is the whole point of the public
# deployment: with it on, a player needs only the Flash projector and the
# address, because csettings_v1.xml goes out too and that is what puts the
# client in WEB mode and points it at this server for everything.
# Off would mean every player supplies their own res/ -- see the package in
# tools/make_client_package.py, which is still the other way to play.
LAVA_HTTP_RES=1

# What the registration page tells people to type, and what csettings_v1.xml
# carries to the client. It has to be reachable from outside this machine, so
# it is never 127.0.0.1 here. Swap it for lava.lab260.ru once that name has
# an A record of its own -- the wildcard on lab260.ru points somewhere else.
LAVA_PUBLIC_HOST=159.194.247.90

# The game socket. Published straight through; this provider does not block
# high ports (checked). Flash asks for its socket policy on 843 first, gets
# nothing, and falls back to asking on this port, which the server answers
# inline -- so 843 does not need to be open.
LAVA_GAME_PORT=9775

# The HTTP side: registration page and, with LAVA_HTTP_RES on, the client.
# Published directly for now. Behind Caddy later: see deploy/Caddyfile.lava,
# and then this can go back to binding 127.0.0.1 only.
LAVA_HTTP_PORT=8080

LAVA_BIND=0.0.0.0
LAVA_LOG_LEVEL=INFO

# 0 = do not take Flash's own policy port. It is privileged, the image runs
# unprivileged, and the inline answer on the game port covers it.
LAVA_POLICY_PORT=0
