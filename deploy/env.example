# Copied to /opt/lava/.env on the first deploy and then left alone.
# docker compose reads it from the directory it is started in.

# The slice of the client the server itself reads: location XML, mobs.xml,
# objects.xml and avatars/list.xml, about 35 MB of the 2.1 GB. Pushed by
# `bash deploy/deploy.sh --with-data`, mounted read-only. The rest is
# artwork, sound and animation the server never opens; it stays on the
# players' own disks.
LAVA_RES_DIR=/opt/lava/res

# Do not hand the client out over HTTP. This is a server, not a game
# distribution: a player brings their own copy and the three-file package
# from tools/make_client_package.py. Turning this on would serve
# csettings_v1.xml as well, which is what puts a client into WEB mode and
# makes it ask this server for every asset -- and the assets are not here.
LAVA_HTTP_RES=0

# What the registration page tells people to type, and what csettings_v1.xml
# carries to the client. It has to be reachable from outside this machine, so
# it is never 127.0.0.1 here. Swap it for lava.devmachine.tech once that name has
# an A record of its own -- devmachine.tech has no wildcard, so the name is free.
LAVA_PUBLIC_HOST=159.194.247.90

# The game socket. Published straight through; this provider does not block
# high ports -- checked with a listener on 9775 answered from outside.
LAVA_GAME_PORT=9775

# The HTTP side: the registration page, and nothing else now that the client
# is not served. Published directly for now; behind Caddy later, see
# deploy/Caddyfile.lava, and then this can bind 127.0.0.1 only.
LAVA_HTTP_PORT=8080

LAVA_BIND=0.0.0.0
LAVA_LOG_LEVEL=INFO

# The policy listener inside the container; docker publishes 843 to it.
# Flash asks there first and only falls back to the game port after that
# attempt ends -- and on this host 843 is dropped, not refused, so the
# fallback would cost the player a visible pause on every connect.
LAVA_POLICY_PORT=8430
LAVA_POLICY_PUBLIC_PORT=843

# Кто может открыть панель /admin — игровые логины через запятую. Пусто:
# панели нет вовсе, все её адреса отвечают 404. Пароль у панели тот же, что
# и в игре: она проверяет его тем же хешем, что лежит в accounts, поэтому
# отдельного склада паролей у неё нет. Логин администратора — то имя, которое
# увидит выкинутый игрок.
LAVA_ADMINS=

# Сколько часов держится вход в панель.
LAVA_ADMIN_HOURS=12
